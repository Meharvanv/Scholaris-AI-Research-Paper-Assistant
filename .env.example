# ─────────────────────────────────────────────────────────────
# Scholaris AI — environment variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# Google Gemini — powers the chat LLM and embeddings (required to run the app)
GOOGLE_API_KEY=your-google-api-key

# Tavily — web search for current info and claim verification (required)
TAVILY_API_KEY=your-tavily-api-key

# Qdrant Cloud — vector store (required)
QDRANT_URL=your-qdrant-cluster-url
QDRANT_API_KEY=your-qdrant-api-key

# OpenAI — used ONLY by the DeepEval evaluation judge (evaluate.py).
# Not needed to run the app.
OPENAI_API_KEY=your-openai-api-key
